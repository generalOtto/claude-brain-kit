#!/usr/bin/env bash
# session-start — Claude Code SessionStart hook for the brain plugin.
# Freshens the brain clone and prints ONE status line; stdout lands in Claude's
# context at session start (matcher startup|clear, launched via hooks/run-hook.cmd).
#
# Modes:
#   (none)          status line (always exits 0)
#   --resolve       print the resolved brain clone path; exit 1 if none
#   --check-wired   exit 0 if ~/.claude/CLAUDE.md imports the brain's CLAUDE.md
#                   (or is a symlink to it); exit 1 + one line otherwise
#
# Invariants (status mode):
#   - ALWAYS exits 0 — a brain problem must never break session start.
#   - Never hangs — no terminal prompts, bounded ssh connect, hard timeout where
#     coreutils provides one.
#   - Report-only beyond the ff-pull — never runs sync, never touches worktrees,
#     never dumps note content into context.
#
# Brain clone resolution (shared with bin/brain-write.sh — keep identical):
#   $BRAIN_DIR → $CLAUDE_PLUGIN_OPTION_BRAIN_DIR → pluginConfigs["brain@claude-brain-kit"] brain_dir in
#   ~/.claude/settings.json → ~/claude-brain (if a git repo) → none.

# ---- path helpers -----------------------------------------------------------
normpath() {                       # ~ expansion, Windows → POSIX, no trailing slash
  local p="$1"
  # shellcheck disable=SC2088  # matching a literal leading tilde is the point
  case "$p" in "~") p="$HOME" ;; "~/"*) p="$HOME/${p#\~/}" ;; esac
  if command -v cygpath >/dev/null 2>&1; then
    p=$(cygpath -u "$p" 2>/dev/null || printf '%s' "$p")
  else
    p=${p//\\//}
  fi
  p=${p%/}
  printf '%s' "$p"
}
path_eq() {                        # case-insensitive on Windows
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) [ "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')" ] ;;
    *) [ "$1" = "$2" ] ;;
  esac
}
resolve_brain() {
  local d="${BRAIN_DIR:-${CLAUDE_PLUGIN_OPTION_BRAIN_DIR:-}}" s="$HOME/.claude/settings.json"
  if [ -z "$d" ] && [ -f "$s" ]; then
    d=$(sed -n '/"brain@claude-brain-kit"/,/^[[:space:]]*}/ s/.*"brain_dir"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$s" | head -1 || true)
    d=${d//\\\\/\\}                # JSON-escaped backslashes
  fi
  if [ -z "$d" ] && git -C "$HOME/claude-brain" rev-parse --git-dir >/dev/null 2>&1; then
    d="$HOME/claude-brain"
  fi
  [ -n "$d" ] || return 1
  normpath "$d"
}
readlink_f() { readlink -f "$1" 2>/dev/null || readlink "$1" 2>/dev/null || printf '%s' "$1"; }

# ---- wired check --------------------------------------------------------------
check_wired() {                    # $1 = brain dir; prints one line, returns 0/1
  local entry="$HOME/.claude/CLAUDE.md" target line p
  target=$(normpath "$(readlink_f "$1/CLAUDE.md")")
  if [ -L "$entry" ]; then
    if path_eq "$(normpath "$(readlink_f "$entry")")" "$target"; then echo "wired (symlink)"; return 0; fi
    echo "not wired: ~/.claude/CLAUDE.md is a symlink to $(readlink "$entry") — add the @import line there by hand"; return 1
  fi
  [ -f "$entry" ] || { echo "not wired: ~/.claude/CLAUDE.md missing"; return 1; }
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}                              # CRLF-saved file
    case "$line" in
      @*) p=$(normpath "$(readlink_f "$(normpath "${line#@}")")")   # canonicalize both sides
          path_eq "$p" "$target" && { echo "wired (@import)"; return 0; } ;;
    esac
  done < "$entry"
  echo "not wired: no @import of $1/CLAUDE.md in ~/.claude/CLAUDE.md"; return 1
}

# ---- modes -----------------------------------------------------------------------
case "${1:-}" in
  --resolve) resolve_brain || { echo "no brain clone found (BRAIN_DIR, plugin option, settings.json pluginConfigs, ~/claude-brain)" >&2; exit 1; }; echo; exit 0 ;;
  --check-wired) BRAIN=$(resolve_brain) || { echo "not wired: no brain clone found"; exit 1; }; check_wired "$BRAIN"; exit $? ;;
esac

# ---- status mode -------------------------------------------------------------------
BRAIN=$(resolve_brain) || { echo "brain: no clone found — set the plugin's brain_dir option or clone to ~/claude-brain, then run /brain:setup"; exit 0; }
git -C "$BRAIN" rev-parse --git-dir >/dev/null 2>&1 || { echo "brain: clone at $BRAIN is missing or broken — brain may be stale"; exit 0; }

export GIT_TERMINAL_PROMPT=0
# Respect a per-clone core.sshCommand (deploy-key setups) — the env var would override it.
ssh_base=$(git -C "$BRAIN" config --get core.sshCommand 2>/dev/null || echo ssh)
export GIT_SSH_COMMAND="$ssh_base -oBatchMode=yes -oConnectTimeout=5"
TIMEOUT_BIN="$(command -v timeout || command -v gtimeout || true)"

before=$(git -C "$BRAIN" rev-parse HEAD 2>/dev/null)
# -q --verify: with an upstream configured but its remote-tracking ref missing, plain rev-parse prints the
# literal '@{u}' on stdout and exits 128 — $upstream became two lines and every ff failed (permanent false STALE).
upstream=$(git -C "$BRAIN" rev-parse -q --verify --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)
if [ -n "$upstream" ]; then upstream_fallback=false; else upstream="origin/main"; upstream_fallback=true; fi
head_branch=$(git -C "$BRAIN" symbolic-ref -q --short HEAD 2>/dev/null)
gitdir=$(git -C "$BRAIN" rev-parse --absolute-git-dir 2>/dev/null)   # --git-dir prints a relative ".git"
# Never move HEAD when the clone is not on the upstream's branch or an operation is in progress
# (`pull --ff-only` refused these; `merge --ff-only` does not) — then the hook is report-only. When
# `@{u}` resolved, HEAD is by definition on the tracking branch even if its local name differs from
# upstream's — only the origin/main FALLBACK needs the branch-name check.
clone_ready() {
  [ -n "$head_branch" ] || return 1
  if $upstream_fallback; then [ "$head_branch" = "${upstream#*/}" ] || return 1; fi
  local f; for f in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do [ -e "$gitdir/$f" ] && return 1; done
  return 0
}
# fetch, then fast-forward from the remote-tracking ref — NOT `git pull`: two sessions starting at once
# (or a second hook on the same clone) interleave their writes to .git/FETCH_HEAD and pull aborts with
# "Cannot fast-forward to multiple branches" although both fetches succeeded.
# Each step is retried once after 1s for the remaining lock races (refs/remotes/*.lock, index.lock); the
# fetch is not retried when the first attempt ran long — that is a stall, not a race.
# -k 5: hard kill if git ignores SIGTERM; low-speed opts bound HTTPS stalls where no timeout binary exists
gfetch() {                         # $1 = seconds budget
  if [ -n "$TIMEOUT_BIN" ]; then "$TIMEOUT_BIN" -k 5 "$1" git -C "$BRAIN" -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 fetch --quiet >/dev/null 2>&1
  else git -C "$BRAIN" -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 fetch --quiet >/dev/null 2>&1; fi
}
ff() {
  if [ -n "$TIMEOUT_BIN" ]; then "$TIMEOUT_BIN" -k 2 5 git -C "$BRAIN" merge --ff-only --quiet "$upstream" >/dev/null 2>&1
  else git -C "$BRAIN" merge --ff-only --quiet "$upstream" >/dev/null 2>&1; fi
}
fetch_ok=false; pull_ok=false; skipped=false; t0=$SECONDS
gfetch 15 && fetch_ok=true
if ! $fetch_ok && [ $((SECONDS - t0)) -lt 10 ]; then sleep 1; gfetch 5 && fetch_ok=true; fi
if $fetch_ok; then
  if clone_ready; then
    ff && pull_ok=true
    if ! $pull_ok; then sleep 1; ff && pull_ok=true; fi
  else skipped=true; fi
fi
if $skipped; then
  status="fetched, pull skipped (clone on '${head_branch:-detached HEAD}' or an operation in progress) — clone may be STALE"
elif $pull_ok; then
  after=$(git -C "$BRAIN" rev-parse HEAD 2>/dev/null)
  if [ "$before" = "$after" ]; then status="fresh"
  else status="pulled $(git -C "$BRAIN" rev-list --count "$before..$after" 2>/dev/null || echo '?') new commit(s)"; fi
else
  status="pull FAILED (offline or diverged) — clone may be STALE"
fi

suffix=""
ahead=$(git -C "$BRAIN" rev-list --count origin/main..main 2>/dev/null || echo 0)
pending=$(git -C "$BRAIN" for-each-ref 'refs/heads/pending-sync/*' | wc -l | tr -d '[:space:]')
if [ "${ahead:-0}" -gt 0 ] || [ "${pending:-0}" -gt 0 ]; then
  suffix="$suffix | UNPUSHED writes waiting (${ahead} on local main, ${pending} pending-sync) — run brain-write.sh sync"
fi
check_wired "$BRAIN" >/dev/null || suffix="$suffix | not wired: run /brain:setup"
days=$(sed -n 's/.*"cleanupPeriodDays"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$HOME/.claude/settings.json" 2>/dev/null | head -1)
days=${days:-30}
[ "$days" -lt 3650 ] && suffix="$suffix | transcripts expire in ${days}d: run /brain:setup"

echo "brain: ${status}${suffix}"
exit 0
