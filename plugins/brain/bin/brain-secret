#!/usr/bin/env bash
# brain-secret — thin wrapper around Bitwarden Secrets Manager's `bws` CLI so Claude
# can fetch a secret itself instead of asking you for it (see docs/zero-friction.md).
#
# Claude never echoes a value: `list` prints only ids and key names, `get` prints the
# raw value alone to stdout so it's meant for `$(brain-secret get NAME)` inside a
# script or command — capture/pipe it, never paste it into chat or a committed file.
#
# Usage:
#   brain-secret list              print "id  KEY" for every secret (no values)
#   brain-secret get <id-or-key>   print the value only (exact KEY match, or an id)
#   brain-secret help
#
# Token file: ${BRAIN_SECRETS_TOKEN_FILE:-$HOME/.config/claude-brain/bws-token}
#   A Bitwarden Secrets Manager machine-account access token, mode 600, nothing else.
#
# No python/jq dependency (the plugin promises "no python" on Windows): parses
# `bws`'s own `-o tsv` output by header name, so it tracks column order changes.
set -euo pipefail

TOKEN_FILE="${BRAIN_SECRETS_TOKEN_FILE:-$HOME/.config/claude-brain/bws-token}"

usage() { sed -n 's/^#   //p' "$0" >&2; }

need_bws() {
  command -v bws >/dev/null 2>&1 || { echo "brain-secret: bws not found — brew install bws / see docs/zero-friction.md" >&2; exit 2; }
}
need_token() {
  [ -f "$TOKEN_FILE" ] || { echo "brain-secret: no token file at $TOKEN_FILE — see docs/zero-friction.md" >&2; exit 2; }
}
bws_() { BWS_ACCESS_TOKEN="$(cat "$TOKEN_FILE")" bws --color no -o tsv "$@"; }

# tsv_col <field-name>  — reads a bws tsv table on stdin, prints that column (by
# header name, case-insensitive) for every data row.
tsv_col() {
  awk -F'\t' -v want="$1" '
    NR==1 { for (i=1;i<=NF;i++) if (tolower($i)==tolower(want)) col=i; next }
    col && NF>=col { print $col }
  '
}

cmd_list() {
  need_bws; need_token
  local tsv
  tsv=$(bws_ secret list) || { echo "brain-secret: bws secret list failed" >&2; exit 2; }
  paste <(printf '%s\n' "$tsv" | tsv_col id) <(printf '%s\n' "$tsv" | tsv_col key) \
    | awk -F'\t' '{printf "%s  %s\n", $1, $2}'
}

cmd_get() {
  need_bws; need_token
  local want=${1:?usage: brain-secret get <id-or-exact-key>}
  local tsv ids keys matches count id
  tsv=$(bws_ secret list) || { echo "brain-secret: bws secret list failed" >&2; exit 2; }
  ids=$(printf '%s\n' "$tsv" | tsv_col id)
  keys=$(printf '%s\n' "$tsv" | tsv_col key)
  matches=$(paste <(printf '%s\n' "$ids") <(printf '%s\n' "$keys") | awk -F'\t' -v k="$want" '$2==k')
  count=$(printf '%s\n' "$matches" | grep -c . || true)
  if [ "$count" -eq 1 ]; then
    id=$(printf '%s' "$matches" | cut -f1)
  elif [ "$count" -gt 1 ]; then
    echo "brain-secret: key '$want' is ambiguous ($count matches) — use the id from 'brain-secret list'" >&2; exit 2
  elif printf '%s\n' "$ids" | grep -qx -- "$want"; then
    id="$want"
  else
    echo "brain-secret: no secret found for '$want' — run 'brain-secret list'" >&2; exit 2
  fi
  bws_ secret get "$id" | tsv_col value
}

case "${1:-}" in
  list) cmd_list ;;
  get)  shift; cmd_get "${1:-}" ;;
  help) usage; exit 0 ;;
  *) usage; exit 2 ;;
esac
