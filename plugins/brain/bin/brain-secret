#!/usr/bin/env bash
# brain-secret — thin wrapper around Bitwarden Secrets Manager's `bws` CLI so Claude
# can fetch a secret itself instead of asking you for it (see docs/zero-friction.md).
#
# Claude never echoes a value: `list` prints only ids and key names, `get` prints the
# raw value alone to stdout so it's meant for `$(brain-secret get NAME)` inside a
# script or command — capture/pipe it, never paste it into chat or a committed file.
# The script never traces itself, but a caller running under `set -x` traces what it
# captures and every command it then hands the value to — keep xtrace off there too.
#
# Usage:
#   brain-secret list              print "id  KEY" for every secret (no values)
#   brain-secret get <id-or-key>   print the value only (exact KEY match, or an id)
#   brain-secret help
#
# Token file: ${BRAIN_SECRETS_TOKEN_FILE:-$HOME/.config/claude-brain/bws-token}
#   A Bitwarden Secrets Manager machine-account access token, mode 600, nothing else.
#
# Parses `bws ... -o json` (never tsv/table/columns — a secret value can contain
# tabs or newlines, which breaks any column-based format). JSON is parsed with the
# first Python 3.6+ that actually runs (python3, python, `py -3`), else jq; if none
# works we refuse to run rather than fall back to a fragile text-splitting parser.

# Never trace. Under xtrace — `bash -x brain-secret …`, or one inherited through an
# exported SHELLOPTS — bash would print the access token as "+ BWS_ACCESS_TOKEN=…".
# Keep this the first command, so nothing here can ever run traced.
set +x
set -euo pipefail

TOKEN_FILE="${BRAIN_SECRETS_TOKEN_FILE:-$HOME/.config/claude-brain/bws-token}"
PARSER=""   # python | jq
PY=()       # the python invocation that passed the probe, e.g. (python3) or (py -3)
JQ=()       # the jq invocation that passed the probe: (jq) or (jq -b)

usage() { sed -n 's/^#   //p' "$0" >&2; }

need_bws() {
  command -v bws >/dev/null 2>&1 || { echo "brain-secret: bws not found — brew install bws / see docs/zero-friction.md" >&2; exit 2; }
}
need_token() {
  [ -f "$TOKEN_FILE" ] || { echo "brain-secret: no token file at $TOKEN_FILE — see docs/zero-friction.md" >&2; exit 2; }
}
# jq_writes_lf <jq invocation...> — true if it runs and writes a newline as the one
# byte LF (an empty raw string prints as just its line end). A native Windows jq.exe
# run from Git Bash writes CRLF for every LF, inside a value too, unless given -b;
# jq before 1.7 has no -b and rejects it, so the flag is probed here rather than
# passed everywhere.
jq_writes_lf() { [ "$("$@" -n -r '""' 2>/dev/null | wc -c | tr -d ' ')" = 1 ]; }

# need_parser — picks the JSON parser by RUNNING each candidate, not by `command -v`:
# on Windows, python3/python on PATH can be the Microsoft Store app-execution alias,
# which only prints "Python was not found" and exits non-zero.
need_parser() {
  local probe='import json, sys; sys.exit(sys.version_info < (3, 6))'   # 3.6: json.load on bytes
  if python3 -c "$probe" >/dev/null 2>&1; then PARSER=python; PY=(python3)
  elif python -c "$probe" >/dev/null 2>&1; then PARSER=python; PY=(python)
  elif py -3 -c "$probe" >/dev/null 2>&1; then PARSER=python; PY=(py -3)
  elif jq_writes_lf jq; then PARSER=jq; JQ=(jq)
  elif jq_writes_lf jq -b; then PARSER=jq; JQ=(jq -b)
  else
    echo "brain-secret: no working JSON parser — needs a Python 3.6+ that runs (python3, python or py -3) or jq (a native Windows jq.exe must be 1.7+); a python on PATH that only fails (e.g. the Windows Store alias) does not count" >&2; exit 2
  fi
}
bws_() { BWS_ACCESS_TOKEN="$(cat "$TOKEN_FILE")" bws --color no -o json "$@"; }

is_uuid() {
  [[ "$1" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]
}

# The python snippets read and write bytes (sys.stdin.buffer / sys.stdout.buffer): in
# text mode a native Windows python writes CRLF for every newline and re-encodes in
# the ANSI code page, which would alter a secret value on its way through.

# json_list — reads a `bws secret list -o json` array on stdin, prints "id<TAB>key"
# per secret sorted by key. Never touches the value field.
json_list() {
  case "$PARSER" in
    python)
      "${PY[@]}" -c '
import json, sys
data = json.load(sys.stdin.buffer)
for s in sorted(data, key=lambda s: s["key"]):
    sys.stdout.buffer.write((s["id"] + "\t" + s["key"] + "\n").encode("utf-8"))
'
      ;;
    jq)
      "${JQ[@]}" -r 'sort_by(.key) | .[] | "\(.id)\t\(.key)"'
      ;;
  esac
}

# json_ids_for_key <key> — reads a `bws secret list -o json` array on stdin, prints
# the id of every secret whose key equals <key> exactly, one per line.
# MSYS2_ARG_CONV_EXCL: without it Git Bash rewrites a key that starts with "/" into
# a Windows path on its way to a native python or jq, and the lookup misses.
json_ids_for_key() {
  case "$PARSER" in
    python)
      MSYS2_ARG_CONV_EXCL='*' "${PY[@]}" -c '
import json, sys
want = sys.argv[1]
data = json.load(sys.stdin.buffer)
for s in data:
    if s["key"] == want:
        sys.stdout.buffer.write((s["id"] + "\n").encode("utf-8"))
' "$1"
      ;;
    jq)
      MSYS2_ARG_CONV_EXCL='*' "${JQ[@]}" -r --arg want "$1" '.[] | select(.key == $want) | .id'
      ;;
  esac
}

# json_value — reads a `bws secret get <id> -o json` object on stdin, writes its
# "value" field exactly to stdout (no added trailing newline; embedded newlines and
# tabs pass through untouched). Piped straight from bws — never captured into a
# bash variable, since `$(...)` would strip a trailing newline off the raw value.
json_value() {
  case "$PARSER" in
    python)
      "${PY[@]}" -c '
import json, sys
data = json.load(sys.stdin.buffer)
sys.stdout.buffer.write(data["value"].encode("utf-8"))
'
      ;;
    jq)
      "${JQ[@]}" -j '.value'
      ;;
  esac
}

cmd_list() {
  need_bws; need_token; need_parser
  bws_ secret list | json_list
}

cmd_get() {
  need_bws; need_token; need_parser
  local want=${1:?usage: brain-secret get <id-or-exact-key>}

  if is_uuid "$want"; then
    bws_ secret get "$want" | json_value \
      || { echo "brain-secret: bws secret get failed" >&2; exit 2; }
    return
  fi

  local matches count
  matches=$(bws_ secret list | json_ids_for_key "$want") \
    || { echo "brain-secret: bws secret list failed" >&2; exit 2; }
  count=$(printf '%s\n' "$matches" | grep -c . || true)

  if [ "$count" -eq 1 ]; then
    bws_ secret get "$matches" | json_value \
      || { echo "brain-secret: bws secret get failed" >&2; exit 2; }
  elif [ "$count" -gt 1 ]; then
    local ids
    ids=$(printf '%s' "$matches" | tr '\n' ' ')
    echo "brain-secret: key '$want' is ambiguous ($count matches: $ids) — use one of these ids instead" >&2; exit 2
  else
    echo "brain-secret: no secret found for '$want' — run 'brain-secret list'" >&2; exit 2
  fi
}

case "${1:-}" in
  list) cmd_list ;;
  get)  shift; cmd_get "${1:-}" ;;
  help) usage; exit 0 ;;
  *) usage; exit 2 ;;
esac
