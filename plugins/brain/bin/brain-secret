#!/usr/bin/env bash
# brain-secret — thin wrapper around Bitwarden Secrets Manager's `bws` CLI so Claude
# can fetch a secret itself instead of asking you for it (see docs/zero-friction.md).
#
# Claude never echoes a value: `list` prints only ids and key names, `get` prints the
# raw value alone to stdout so it's meant for `$(brain-secret get NAME)` inside a
# script or command — capture/pipe it, never paste it into chat or a committed file.
#
# Usage:
#   brain-secret list              print "id  KEY" for every secret (no values)
#   brain-secret get <id-or-key>   print the value only (exact KEY match, or an id)
#   brain-secret help
#
# Token file: ${BRAIN_SECRETS_TOKEN_FILE:-$HOME/.config/claude-brain/bws-token}
#   A Bitwarden Secrets Manager machine-account access token, mode 600, nothing else.
#
# Parses `bws ... -o json` (never tsv/table/columns — a secret value can contain
# tabs or newlines, which breaks any column-based format). JSON is parsed with
# python3, falling back to jq if python3 isn't on PATH; if neither is available we
# refuse to run rather than fall back to a fragile text-splitting parser.
set -euo pipefail

TOKEN_FILE="${BRAIN_SECRETS_TOKEN_FILE:-$HOME/.config/claude-brain/bws-token}"
PARSER=""

usage() { sed -n 's/^#   //p' "$0" >&2; }

need_bws() {
  command -v bws >/dev/null 2>&1 || { echo "brain-secret: bws not found — brew install bws / see docs/zero-friction.md" >&2; exit 2; }
}
need_token() {
  [ -f "$TOKEN_FILE" ] || { echo "brain-secret: no token file at $TOKEN_FILE — see docs/zero-friction.md" >&2; exit 2; }
}
need_parser() {
  if command -v python3 >/dev/null 2>&1; then
    PARSER=python3
  elif command -v jq >/dev/null 2>&1; then
    PARSER=jq
  else
    echo "brain-secret needs python3 or jq" >&2; exit 2
  fi
}
bws_() { BWS_ACCESS_TOKEN="$(cat "$TOKEN_FILE")" bws --color no -o json "$@"; }

is_uuid() {
  [[ "$1" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]
}

# json_list — reads a `bws secret list -o json` array on stdin, prints "id<TAB>key"
# per secret sorted by key. Never touches the value field.
json_list() {
  case "$PARSER" in
    python3)
      python3 -c '
import json, sys
data = json.load(sys.stdin)
for s in sorted(data, key=lambda s: s["key"]):
    print(s["id"] + "\t" + s["key"])
'
      ;;
    jq)
      jq -r 'sort_by(.key) | .[] | "\(.id)\t\(.key)"'
      ;;
  esac
}

# json_ids_for_key <key> — reads a `bws secret list -o json` array on stdin, prints
# the id of every secret whose key equals <key> exactly, one per line.
json_ids_for_key() {
  case "$PARSER" in
    python3)
      python3 -c '
import json, sys
want = sys.argv[1]
data = json.load(sys.stdin)
for s in data:
    if s["key"] == want:
        print(s["id"])
' "$1"
      ;;
    jq)
      jq -r --arg want "$1" '.[] | select(.key == $want) | .id'
      ;;
  esac
}

# json_value — reads a `bws secret get <id> -o json` object on stdin, writes its
# "value" field exactly to stdout (no added trailing newline; embedded newlines and
# tabs pass through untouched). Piped straight from bws — never captured into a
# bash variable, since `$(...)` would strip a trailing newline off the raw value.
json_value() {
  case "$PARSER" in
    python3)
      python3 -c '
import json, sys
data = json.load(sys.stdin)
sys.stdout.write(data["value"])
'
      ;;
    jq)
      jq -j '.value'
      ;;
  esac
}

cmd_list() {
  need_bws; need_token; need_parser
  bws_ secret list | json_list
}

cmd_get() {
  need_bws; need_token; need_parser
  local want=${1:?usage: brain-secret get <id-or-exact-key>}

  if is_uuid "$want"; then
    bws_ secret get "$want" | json_value \
      || { echo "brain-secret: bws secret get failed" >&2; exit 2; }
    return
  fi

  local matches count
  matches=$(bws_ secret list | json_ids_for_key "$want") \
    || { echo "brain-secret: bws secret list failed" >&2; exit 2; }
  count=$(printf '%s\n' "$matches" | grep -c . || true)

  if [ "$count" -eq 1 ]; then
    bws_ secret get "$matches" | json_value \
      || { echo "brain-secret: bws secret get failed" >&2; exit 2; }
  elif [ "$count" -gt 1 ]; then
    local ids
    ids=$(printf '%s' "$matches" | tr '\n' ' ')
    echo "brain-secret: key '$want' is ambiguous ($count matches: $ids) — use one of these ids instead" >&2; exit 2
  else
    echo "brain-secret: no secret found for '$want' — run 'brain-secret list'" >&2; exit 2
  fi
}

case "${1:-}" in
  list) cmd_list ;;
  get)  shift; cmd_get "${1:-}" ;;
  help) usage; exit 0 ;;
  *) usage; exit 2 ;;
esac
