#!/usr/bin/env bash
# brain-keepalive-install — install a weekly keepalive that pings `claude` so the
# OAuth login token never lapses from inactivity (see docs/zero-friction.md).
#
# Usage:
#   brain-keepalive-install              install (idempotent — safe to re-run)
#   brain-keepalive-install --uninstall  remove everything it installed
#
# macOS              → LaunchAgent ~/Library/LaunchAgents/com.claude-brain.keepalive.plist
# Linux (systemd)     → systemd --user service+timer claude-brain-keepalive.{service,timer}
# Windows (Git Bash)  → writes a claude-keepalive.cmd wrapper (Git Bash by full path) and
#                       prints a `schtasks` one-liner for you to run yourself, exits 0
#
# Runs weekly, Mondays 09:15 local time:
#   claude -p 'Reply with the single word OK.' --output-format text < /dev/null
# Logs every run to ~/.config/claude-brain/claude-keepalive.log.
set -euo pipefail

CONF_DIR="$HOME/.config/claude-brain"
SCRIPT="$CONF_DIR/claude-keepalive.sh"
WRAPPER="$CONF_DIR/claude-keepalive.cmd"   # Windows only
LOG="$CONF_DIR/claude-keepalive.log"
LABEL="com.claude-brain.keepalive"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
SYSTEMD_DIR="$HOME/.config/systemd/user"
SERVICE="$SYSTEMD_DIR/claude-brain-keepalive.service"
TIMER="$SYSTEMD_DIR/claude-brain-keepalive.timer"

is_windows() { case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) return 0 ;; *) return 1 ;; esac; }
is_macos()   { [ "$(uname -s)" = "Darwin" ]; }

write_keepalive_script() {
  mkdir -p "$CONF_DIR"
  cat > "$SCRIPT" <<'EOS'
#!/usr/bin/env bash
# claude-keepalive.sh — installed by brain-keepalive-install. Pings claude so the
# OAuth login token never lapses from inactivity; logs every run.
set -uo pipefail
LOG="$HOME/.config/claude-brain/claude-keepalive.log"
mkdir -p "$(dirname "$LOG")"
{
  echo "== $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if command -v claude >/dev/null 2>&1; then
    # stdin from /dev/null: a scheduler hands claude no stdin, and it would wait 3s
    # for some and log a warning on every run
    out=$(claude -p 'Reply with the single word OK.' --output-format text 2>&1 < /dev/null)
    echo "$out"
    case "$out" in
      *OK*) : ;;
      *) echo "keepalive: unexpected reply — login may have expired, run: claude login" ;;
    esac
  else
    echo "keepalive: claude CLI not found on PATH"
  fi
} >> "$LOG" 2>&1
EOS
  chmod +x "$SCRIPT"
}

abs_dir() { CDPATH='' cd -- "$(dirname -- "$1")" && pwd; }
# dedupe_path — a PATH with each directory once, first occurrence kept
dedupe_path() {
  local out="" d parts
  IFS=: read -ra parts <<< "$1"
  for d in "${parts[@]}"; do
    [ -n "$d" ] || continue
    case ":$out:" in *":$d:"*) ;; *) out=${out:+$out:}$d ;; esac
  done
  printf '%s' "$out"
}

# job_path <system dirs> — the PATH the scheduled job gets. Neither a systemd --user
# manager nor launchd has ~/.local/bin (where the native installer puts claude) on its
# PATH, and launchd has no Homebrew either, so the job names the directory claude is
# in now, ahead of the system ones. The directory, not the resolved binary: the
# installer's ~/.local/bin/claude is a symlink it repoints on every update. A claude
# that is a script (an npm install) also needs its node, which a version manager may
# keep elsewhere, so node's directory comes along too. Fails when there is no claude.
job_path() {
  local bin dir nd path="$1"
  bin=$(type -P claude) || return 1
  if [ "$(head -c 2 "$bin" 2>/dev/null)" = "#!" ] && type -P node >/dev/null; then
    nd=$(abs_dir "$(type -P node)") && path="$nd:$path"
  fi
  dir=$(abs_dir "$bin") || return 1
  dedupe_path "$dir:$path"
}

no_claude() {
  echo "brain-keepalive-install: claude CLI not found on PATH — install Claude Code, open a new shell so claude is on PATH, then re-run brain-keepalive-install" >&2
  exit 1
}

# xml_escape — text safe inside a plist <string>. sed, not ${//}: bash 5.2 reads an
# unquoted & in a replacement as the matched text.
xml_escape() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

install_macos() {
  local path
  path=$(job_path "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin") || no_claude
  write_keepalive_script
  mkdir -p "$(dirname "$PLIST")"
  cat > "$PLIST" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>bash</string>
    <string>$(xml_escape "$SCRIPT")</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$(xml_escape "$path")</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>15</integer>
  </dict>
  <key>StandardOutPath</key><string>$(xml_escape "$LOG")</string>
  <key>StandardErrorPath</key><string>$(xml_escape "$LOG")</string>
</dict>
</plist>
PLIST_EOF
  local uid; uid=$(id -u)
  launchctl bootout "gui/$uid" "$PLIST" >/dev/null 2>&1 || true
  launchctl bootstrap "gui/$uid" "$PLIST"
  echo "brain-keepalive-install: installed LaunchAgent $PLIST"
}

uninstall_macos() {
  local uid; uid=$(id -u)
  if [ -f "$PLIST" ]; then
    launchctl bootout "gui/$uid" "$PLIST" >/dev/null 2>&1 || true
    rm -f "$PLIST"
  fi
  rm -f "$SCRIPT"
  echo "brain-keepalive-install: removed LaunchAgent"
}

# service_path — the Environment= line for the systemd unit: job_path, quoted for
# systemd's word splitting, with \ and " escaped inside the quotes and % doubled so
# systemd doesn't read it as a specifier.
service_path() {
  local path
  path=$(job_path "/usr/local/bin:/usr/bin:/bin") || return 1
  path=${path//\\/\\\\}; path=${path//\"/\\\"}; path=${path//%/%%}
  printf 'Environment="PATH=%s"\n' "$path"
}

install_linux() {
  local env_line
  env_line=$(service_path) || no_claude
  write_keepalive_script
  mkdir -p "$SYSTEMD_DIR"
  cat > "$SERVICE" <<EOS
[Unit]
Description=claude-brain keepalive — pings claude weekly so the OAuth login never lapses

[Service]
Type=oneshot
$env_line
ExecStart=/usr/bin/env bash $SCRIPT
EOS
  cat > "$TIMER" <<EOS
[Unit]
Description=Weekly timer for claude-brain keepalive

[Timer]
OnCalendar=Mon *-*-* 09:15:00
Persistent=true

[Install]
WantedBy=timers.target
EOS
  systemctl --user daemon-reload
  systemctl --user enable --now claude-brain-keepalive.timer
  echo "brain-keepalive-install: installed systemd --user timer claude-brain-keepalive.timer"
}

uninstall_linux() {
  systemctl --user disable --now claude-brain-keepalive.timer >/dev/null 2>&1 || true
  rm -f "$SERVICE" "$TIMER"
  systemctl --user daemon-reload >/dev/null 2>&1 || true
  rm -f "$SCRIPT"
  echo "brain-keepalive-install: removed systemd --user timer"
}

# git_bash_exe — Windows path of the bash.exe the scheduled task should run. Task
# Scheduler resolves a bare `bash` from the Windows PATH, where it is usually WSL's
# launcher (or nothing) and not Git Bash, so the task has to name it in full. Prefer
# Git for Windows' <root>\bin\bash.exe launcher; elsewhere (MSYS2, Cygwin) fall back
# to the bash this script is running under.
git_bash_exe() {
  local root
  root=$(cygpath -w /) || return 1
  root=${root%\\}
  if [ -f "$root\\bin\\bash.exe" ]; then
    printf '%s\n' "$root\\bin\\bash.exe"
  else
    cygpath -w "$(command -v bash)"
  fi
}

# write_windows_wrapper <bash.exe> — a .cmd beside the keepalive script for the task
# to run. Pointing /TR at this one file keeps the bash path (usually under "Program
# Files") out of schtasks' quoting, and `~` keeps the home path out of the file: bash
# expands it when the task runs. CRLF, as cmd expects; `chcp 65001` because the file
# is UTF-8 and cmd would otherwise read a non-ASCII bash path in the OEM code page.
write_windows_wrapper() {
  {
    printf '@echo off\r\n'
    printf 'rem Installed by brain-keepalive-install; the claude-brain-keepalive task runs this.\r\n'
    printf 'rem Git Bash is called by full path: a bare "bash" in a scheduled task is not Git Bash.\r\n'
    printf 'chcp 65001 >nul\r\n'
    printf '"%s" -lc "~/%s"\r\n' "$1" "${SCRIPT#"$HOME"/}"
  } > "$WRAPPER"
}

print_windows() {
  write_keepalive_script
  local bash_exe wrapper_win taskrun shells="Command Prompt or PowerShell"
  bash_exe=$(git_bash_exe) || bash_exe=""
  [ -n "$bash_exe" ] || { echo "brain-keepalive-install: can't work out this shell's bash.exe path (cygpath failed)" >&2; exit 1; }
  write_windows_wrapper "$bash_exe"
  wrapper_win=$(cygpath -w "$WRAPPER")
  # A program path with spaces has to be quoted inside /TR's own double quotes. Single
  # quotes work from Command Prompt and PowerShell alike, but end at an apostrophe in
  # the path (schtasks then registers a broken task without complaint); that case
  # needs \"...\", which only Command Prompt parses.
  case "$wrapper_win" in
    *" "*"'"*|*"'"*" "*) taskrun="\\\"$wrapper_win\\\""; shells="Command Prompt (not PowerShell)" ;;
    *" "*) taskrun="'$wrapper_win'" ;;
    *) taskrun="$wrapper_win" ;;
  esac
  echo "brain-keepalive-install: Windows detected — wrote the keepalive script and a"
  echo "claude-keepalive.cmd wrapper that runs it in Git Bash. Registering the weekly task"
  echo "is yours to do once, in an ordinary (non-admin) $shells"
  echo "window — not Git Bash, which rewrites the /switches as paths:"
  echo
  echo "  schtasks /Create /SC WEEKLY /D MON /ST 09:15 /TN \"claude-brain-keepalive\" /TR \"$taskrun\" /F"
  echo
  echo "Remove later with: schtasks /Delete /TN \"claude-brain-keepalive\" /F"
}

case "${1:-}" in
  --uninstall)
    if is_windows; then
      echo "brain-keepalive-install: Windows — remove the task yourself: schtasks /Delete /TN \"claude-brain-keepalive\" /F"
      rm -f "$SCRIPT" "$WRAPPER"
    elif is_macos; then uninstall_macos
    else uninstall_linux
    fi
    ;;
  "")
    if is_windows; then print_windows
    elif is_macos; then install_macos
    else install_linux
    fi
    ;;
  *) sed -n 's/^#   //p' "$0" >&2; exit 2 ;;
esac
