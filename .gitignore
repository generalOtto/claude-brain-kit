# Safety net — the brain stores POINTERS, never secret values.
*.env
*.env.*
*.p8
*.pem
*.key
*.keystore
*.p12
id_rsa*
id_ed25519*
*secret*.txt
*token*.txt
secrets.env

# OS noise
.DS_Store
Thumbs.db

# Obsidian viewer (optional) — device-local state and plugin runtime data (can hold
# tokens), never synced. See docs/more-surfaces.md, "Obsidian as a viewer".
.obsidian/workspace*.json
.obsidian/plugins/*/data.json
.obsidian/cache

# local dev plans (never shipped)
docs/superpowers/

# local git worktrees (never shipped)
.worktrees/
.superpowers/

# any stray node_modules (vitest run from the wrong cwd once leaked a cache file)
node_modules/
